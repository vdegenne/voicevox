{
	"name": "@vdegenne/voicevox",
	"version": "0.1.19",
	"description": "Snar reactive controller TS helper to interact with VoiceVox TTS server.",
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/client.d.ts",
			"import": "./lib/client.js"
		},
		"./core": {
			"types": "./lib/core.d.ts",
			"import": "./lib/core.js"
		}
	},
	"files": [
		"./lib"
	],
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src/"
			],
			"output": [
				"./lib/"
			]
		}
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"wireit": "^0.15.0"
	}
}
